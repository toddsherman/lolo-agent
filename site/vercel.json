{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/lolo/cms-copy.js", "destination": "/cms-copy.js" },
    { "source": "/lolo/visual-editing.js", "destination": "/visual-editing.js" },
    { "source": "/lolo/visual-editing.css", "destination": "/visual-editing.css" }
  ],
  "headers": [
    {
      "source": "/lolo-og.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    },
    {
      "source": "/lolo-hero.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    },
    {
      "source": "/cms-copy.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/visual-editing.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/visual-editing.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
